# Resend (https://resend.com) — used to send the order-notification email.
# Without this set, order creation still works; the email is skipped with a console warning.
RESEND_API_KEY=

# Sender address. Use onboarding@resend.dev for local/dev testing (no domain verification needed),
# or a verified sender on your own domain in production.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Who receives the "new order" alert. Defaults to marcolorenzoromero@gmail.com if unset.
ADMIN_NOTIFICATION_EMAIL=marcolorenzoromero@gmail.com
