# Resend (https://resend.com) — used to send the order-notification email.
# Without this set, order creation still works; the email is skipped with a console warning.
RESEND_API_KEY=

# Sender address. Use onboarding@resend.dev for local/dev testing (no domain verification needed),
# or a verified sender on your own domain in production.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Note: who receives the "new order" alert is no longer set here — it's an
# admin-editable value in the `settings` table (admin_notification_email).

# Supabase (https://supabase.com) — database, auth, storage.
# Find these in your project's Settings > API page. Never put the actual
# service role key value in this file (.env.example is committed to git) —
# only in .env.local.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Same URL/anon key as above, duplicated with the NEXT_PUBLIC_ prefix —
# Next.js only inlines NEXT_PUBLIC_* vars into browser bundles, and the
# Google login flow (Phase 4) runs Supabase Auth client-side. Not a
# separate secret; the anon key is meant to be public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared secret checked by POST /api/orders/expire so only the scheduled
# job (not any random caller) can trigger order expiry. Vercel Cron sends
# this automatically as "Authorization: Bearer $CRON_SECRET" once the env
# var is set in the Vercel project — generate any random string.
CRON_SECRET=
